{
  "expo": {
    "name": "Silence Game",
    "slug": "silence-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0820",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alejandrorodriguez.silencegame",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.alejandrorodriguez.silencegame",
      "adaptiveIcon": {
        "backgroundColor": "#1E1B4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "The owl listens to the noise level to know who breaks the silence. Nothing is recorded or saved.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1B4B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "locales": {
      "es": "./languages/es.json",
      "en": "./languages/en.json"
    }
  }
}
